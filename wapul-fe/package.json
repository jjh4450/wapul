{
  "name": "wapul-fe",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "(svelte-kit sync && pnpm api:gen) || echo ''",
    "check": "svelte-kit sync && pnpm api:gen && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && pnpm api:gen && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint . && oxlint && pnpm ui:check",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ui:add": "node tools/ui-stories.ts --add",
    "ui:stories": "node tools/ui-stories.ts",
    "ui:check": "node tools/ui-stories.ts --check",
    "api:gen": "openapi-typescript ../openapi/openapi.json -o src/lib/api/schema.ts"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@oxlint/plugins": "1.86.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-svelte-csf": "latest",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/sveltekit": "^10.6.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tabler/icons-svelte": "^3.48.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "bits-ui": "^2.19.5",
    "cn": "^0.4.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "mdsvex": "^0.12.7",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "1.86.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn-svelte": "^1.7.0",
    "storybook": "^10.6.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^3.1.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
