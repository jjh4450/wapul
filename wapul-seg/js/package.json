{
  "name": "wapul-seg",
  "version": "0.0.0",
  "description": "wapul block-splitting model for the browser: statement kinds and logic blocks for solution code via web-tree-sitter and a LightGBM WASM",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjh4450/wapul.git",
    "directory": "wapul-seg/js"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/wapul-seg.d.ts",
      "default": "./dist/wapul-seg.js"
    },
    "./*": "./dist/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && node tools/bundle.ts",
    "check": "tsc --noEmit",
    "lint": "prettier --check . && eslint . && oxlint",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@oxlint/plugins": "1.86.0",
    "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
    "@types/node": "^24",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "oxlint": "1.86.0",
    "prettier": "^3.8.3",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-php": "0.24.1",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-scala": "0.24.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.3.0",
    "vite-plugin-dts": "5.1.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "web-tree-sitter": "0.27.0"
  }
}
