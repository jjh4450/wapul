# ============================================================
# 환경 변수 설정 예시
# 이 파일을 .env로 복사하여 사용하세요
# ============================================================

# ============================================================
# 애플리케이션 설정
# ============================================================
APP_NAME=wapul-be
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ============================================================
# 데이터베이스 설정
# ============================================================

# SQLite (기본값 - 개발/테스트용)
DATABASE_URL=sqlite:///./wapul.db

# PostgreSQL (프로덕션 권장)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# 커넥션 풀 설정 (PostgreSQL 등 외부 DB용)
POOL_SIZE=5
MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# DB Keep-Alive
# 유휴 시 DB가 자동 정지되거나 연결이 끊기는 것을 막기 위해
# 주기적으로 가벼운 쿼리(SELECT 1)를 실행합니다.
# (예: 일정 시간 트래픽이 없으면 인스턴스를 정지시키는 무료 호스팅 DB의 유휴 정지 방지)
# 값(초)이 0 이하이면 비활성화됩니다. 예: 300 = 5분마다 ping
DB_KEEPALIVE_INTERVAL_SECONDS=0

# ============================================================
# OIDC 인증 설정
# ============================================================
OIDC_ENABLED=true
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_AUDIENCE=your-client-id
# OIDC_DISCOVERY_URL=  # 기본: OIDC_ISSUER_URL/.well-known/openid-configuration
OIDC_JWKS_CACHE_TTL_SECONDS=3600

# ============================================================
# Rate Limit 설정
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_DEFAULT_REQUESTS=60


# ============================================================
# 코드 블럭 분할
# ============================================================
# rule: 규칙 분할기 (기본), llm: Claude API로 분할 (실패하면 rule로 대신함)
SEGMENTER=rule
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=high
